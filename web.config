<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="NextJS" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="app.js" />
        </rule>
      </rules>
    </rewrite>
    <directoryBrowse enabled="false" />
    <iisnode loggingEnabled="true" devErrorsEnabled="true" debuggingEnabled="true" />
        <handlers>
            <add name="iisnode" path="*.js" verb="*" modules="iisnode" />
        </handlers>
  </system.webServer>
</configuration>
